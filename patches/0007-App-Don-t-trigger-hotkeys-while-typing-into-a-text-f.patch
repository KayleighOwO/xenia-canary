From 73f61074cba404f4a0917bfc09a306d4f1bba43f Mon Sep 17 00:00:00 2001
From: Xenia UI <ui@example.invalid>
Date: Sun, 4 Oct 2026 01:47:14 +0000
Subject: [PATCH 07/10] [App] Don't trigger hotkeys while typing into a text
 field

ImGuiDrawer::OnKey() forwards key events to ImGui but never marks them
handled, so EmulatorWindow::OnKeyDown() still reacts to every keystroke.
Typing '-', '+' or '*' on the numpad into any ImGui text field therefore
changed the CPU time scalar. Ignore key presses while ImGui wants text input.
---
 src/xenia/app/emulator_window.cc | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/xenia/app/emulator_window.cc b/src/xenia/app/emulator_window.cc
index fbd2f9864..957687a01 100644
--- a/src/xenia/app/emulator_window.cc
+++ b/src/xenia/app/emulator_window.cc
@@ -1044,6 +1044,12 @@ void EmulatorWindow::OnKeyDown(ui::KeyEvent& e) {
     return;
   }
 
+  // Typing into a text field (e.g. in an ImGui dialog) must not also trigger
+  // hotkeys such as the numpad CPU time scalar keys.
+  if (imgui_drawer_ && imgui_drawer_->GetIO().WantTextInput) {
+    return;
+  }
+
   switch (e.virtual_key()) {
     case ui::VirtualKey::kO: {
       if (!e.is_ctrl_pressed()) {
-- 
