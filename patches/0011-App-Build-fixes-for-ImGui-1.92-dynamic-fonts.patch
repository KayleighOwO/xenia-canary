+  launcher::PopTitleFont();
   ImGui::SameLine(0.0f, 20.0f * s);
 
   if (focus_search_) {
@@ -722,9 +725,9 @@ void LibraryDialog::DrawEmptyState() {
 
   const bool no_games_at_all = games_.empty();
   if (no_games_at_all && folders_.empty()) {
