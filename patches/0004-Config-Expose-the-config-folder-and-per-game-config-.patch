From 3282fc5e719f6c197817235e11c5099dfefa1488 Mon Sep 17 00:00:00 2001
From: Xenia UI <ui@example.invalid>
Date: Sat, 3 Oct 2026 09:35:54 +0000
Subject: [PATCH 04/10] [Config] Expose the config folder and per-game config
 path

Lets tools find (and write) the per-game config of a title without
duplicating how the path is built. LoadGameConfig() now uses the same helper;
behaviour is unchanged.
---
 src/xenia/config.cc | 10 +++++++---
 src/xenia/config.h  |  5 +++++
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/src/xenia/config.cc b/src/xenia/config.cc
index 86305099b..cb05e3b56 100644
--- a/src/xenia/config.cc
+++ b/src/xenia/config.cc
@@ -305,10 +305,14 @@ void SetupConfig(const std::filesystem::path& config_folder) {
   }
 }
 
+const std::filesystem::path& GetConfigFolder() { return config_folder; }
+
+std::filesystem::path GetGameConfigPath(const std::string_view title_id) {
+  return config_folder / "config" / (std::string(title_id) + game_config_suffix);
+}
+
 void LoadGameConfig(const std::string_view title_id) {
-  const auto game_config_folder = config_folder / "config";
-  const auto game_config_path =
-      game_config_folder / (std::string(title_id) + game_config_suffix);
+  const auto game_config_path = GetGameConfigPath(title_id);
   if (std::filesystem::exists(game_config_path)) {
     ReadGameConfig(game_config_path);
   }
diff --git a/src/xenia/config.h b/src/xenia/config.h
index 9c811d9de..1abac94c7 100644
--- a/src/xenia/config.h
+++ b/src/xenia/config.h
@@ -26,6 +26,11 @@ namespace config {
 void SetupConfig(const std::filesystem::path& config_folder);
 void LoadGameConfig(const std::string_view title_id);
 void SaveConfig();
+
+// The folder the global config lives in. Empty before SetupConfig().
+const std::filesystem::path& GetConfigFolder();
+// Where the per-game config of a title (eight hex digits) is read from.
+std::filesystem::path GetGameConfigPath(const std::string_view title_id);
 }  // namespace config
 
 #endif  // XENIA_CONFIG_H_
-- 
